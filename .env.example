DATABASE_URL=postgresql+psycopg://widget:widget@postgres:5432/widget_platform
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-development-secret
PUBLIC_BASE_URL=http://localhost:8000
GEO_PROVIDER_A_URL=https://ip-api.com/json/{ip}
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/
NOTIFICATION_MODE=log
RATE_LIMIT_IP_PER_MINUTE=10
RATE_LIMIT_WIDGET_PER_MINUTE=30
MAX_PUBLIC_PAYLOAD_BYTES=16384
TRUST_PROXY_HEADERS=false
